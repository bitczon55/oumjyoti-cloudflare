{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oumjyoti-seva",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oumjyoti-seva-db-v2",
      "database_id": "b82c4f3e-03c0-40b3-8fe2-aa7387d735f1",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "oumjyoti-images"
    }
  ]
}
