{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oumjyoti-seva",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oumjyoti-seva-db",
      "database_id": "e9578861-a4bc-4252-8241-f83660010381",
      "migrations_dir": "migrations"
    }
  ]
}